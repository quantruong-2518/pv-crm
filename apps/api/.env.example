# Chép thành `.env` rồi sửa. `.env` bị .gitignore chặn — không commit.

# ---------------------------------------------------------------------------
# DATABASE — mặc định KHÔNG cần cài gì
# ---------------------------------------------------------------------------
# `pglite://` chạy CHÍNH Postgres, biên dịch sang WASM, trong tiến trình Node
# này: không container, không daemon, không cổng, không sudo. Cùng engine nên
# recursive CTE, hai schema, `text[]`, `uuid` đều chạy y hệt.
#
#   pglite://./.pglite   dữ liệu nằm trong thư mục đó, còn sau khi tắt
#   pglite://memory      chết theo tiến trình — dùng cho test
#
# Đổi sang Postgres thật (giống production) thì `pnpm db:up` rồi dùng dòng bị
# ghi chú bên dưới. `env.ts` từ chối khởi động nếu thấy `pglite://` ở
# NODE_ENV=production.
DATABASE_URL=pglite://./.pglite
# DATABASE_URL=postgres://pv:pv@localhost:5432/pv_crm

# Neon (production) — copy chuỗi "Pooled connection" từ Neon dashboard.
# `sslmode=require` là bắt buộc, Neon từ chối kết nối không TLS.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# 4123 là cổng TẠI MÁY — `apps/web/.env` và `docs/tich-hop-be.md` đều trỏ vào
# đó, để `pnpm dev:api` + `pnpm dev` khớp nhau mà không phải nhớ cờ nào. Trong
# container KHÔNG có file này, nên máy chủ lùi về mặc định 3000 của `env.ts`,
# đúng bằng `EXPOSE` ở Dockerfile và `internal_port` ở fly.toml. Đổi dòng này
# không đụng gì tới production.
PORT=4123
NODE_ENV=development

# ---------------------------------------------------------------------------
# CỬA SAU CHO curl/Postman — giờ chỉ còn là ĐƯỜNG LÙI, không phải đường vào
# ---------------------------------------------------------------------------
# Đường vào thật là cookie `pv_session`: `POST /auth/sign-in` đặt cookie,
# `ActorGuard` đọc cookie đó rồi tra `platform.session`. Header `X-PV-Actor-Id`
# chỉ được hỏi tới khi KHÔNG có cookie nào — thứ tự đó là luật, không phải sở
# thích: nếu header thắng cookie thì bất cứ thứ gì gắn được header (một
# extension, một proxy, một đoạn tooling ai đó quên gỡ) đều đóng vai được người
# đang đăng nhập thật.
#
# Bật cờ này = máy chủ TIN header và coi người gọi là actor mang id đó, tức bất
# kỳ ai gọi được API cũng đóng vai được bất kỳ ai. Nó tồn tại vì `curl` và
# Postman không có màn đăng nhập.
#
# Mặc định TẮT, có chủ ý: chỉ khi tắt thì đường cookie thật mới là đường được
# chạy hằng ngày ở máy phát triển, và một lỗi ở tầng cookie mới lộ ra tại đây
# thay vì lộ ra trên production. Bật khi cần gõ tay, rồi tắt lại.
#
# `env.ts` từ chối khởi động nếu cờ này bật khi NODE_ENV=production.
PV_TRUST_ACTOR_HEADER=false

# ---------------------------------------------------------------------------
# LANDING PAGE INTAKE — cửa ghi công khai
# ---------------------------------------------------------------------------
# Danh sách phân cách bằng dấu phẩy. Ở production, cả hai danh sách và secret
# đều bắt buộc; máy chủ từ chối khởi động nếu thiếu để không vô tình mở một cửa
# ghi không có hàng rào.
PV_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PV_INTAKE_LANDING_PAGES=pv-one-demo

# Dev dùng được giá trị mặc định. Production tạo secret riêng, ví dụ:
#   openssl rand -hex 32
PV_INTAKE_IP_HASH_SECRET=development-only-intake-secret

# Một IP: tối đa 5/phút và 30/ngày. Một landing page: tối đa 120/phút và
# 5.000/ngày. Bộ đếm nằm trong Postgres nên nhiều API instance vẫn dùng chung.
PV_INTAKE_RATE_PER_MINUTE=5
PV_INTAKE_RATE_PER_DAY=30
PV_INTAKE_PAGE_RATE_PER_MINUTE=120
PV_INTAKE_PAGE_RATE_PER_DAY=5000
PV_INTAKE_MAX_INFLIGHT=8

# ---------------------------------------------------------------------------
# MAIL — cửa ra ngoài công ty, mặc định ĐÓNG
# ---------------------------------------------------------------------------
# `PV_EMAIL_ENABLED=false` KHÔNG tắt hàng đợi. Job vẫn chạy, sổ gửi vẫn ghi,
# chỉ không có request nào rời khỏi máy này. Xem trước một email thật mà không
# bắn nhầm vào hộp thư người thật — trạng thái đúng của mọi máy phát triển.
PV_EMAIL_ENABLED=false

# Khoá thật: đặt bằng `fly secrets set`, KHÔNG commit.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# `From` phải thuộc domain đã verify trên Resend. Dùng subdomain riêng để
# reputation của mail hệ thống không dính vào hộp thư người thật đang gửi qua
# Google Workspace.
PV_EMAIL_FROM=PV One CRM <leads@notify.pebblevina.com>
PV_EMAIL_REPLY_TO=contact@pebblevina.com
PV_LEAD_NOTIFICATION_TO=contact@pebblevina.com

# `From` của HAI lá thư mang link mật khẩu: lời mời, và đặt lại mật khẩu.
# Bỏ trống = dùng chung PV_EMAIL_FROM, và đó là cấu hình hợp lệ.
#
# Đáng tách vì PV_EMAIL_FROM mặc định là `leads@` — một lá thư bảo "bấm vào đây
# để đặt mật khẩu" gửi từ hộp thư lead là đúng hình dạng một cú lừa, và nó dạy
# người trong công ty rằng thư đặt mật khẩu đến từ địa chỉ nào cũng được.
# Khác lý do với PV_EMAIL_MAS_FROM bên dưới: cái kia bảo vệ reputation của tên
# miền, cái này để NGƯỜI NHẬN nhận ra được thư mở cửa tài khoản của chính họ.
PV_AUTH_EMAIL_FROM=

# Gốc app web — email nội bộ mang một liên kết mở thẳng lead trong CRM.
PV_APP_URL=http://localhost:5173

# Nhịp gửi. Trần tự đặt, thấp hơn trần tài khoản Resend để chừa chỗ.
PV_EMAIL_RATE_PER_SECOND=4
PV_EMAIL_WORKER_CONCURRENCY=2
PV_EMAIL_RETRY_LIMIT=8
PV_EMAIL_RETRY_DELAY_SECONDS=5
PV_EMAIL_RETRY_DELAY_MAX_SECONDS=900

# ---------------------------------------------------------------------------
# MAS — mail marketing hàng loạt, CỬA THỨ HAI và có công tắc riêng
# ---------------------------------------------------------------------------
# Tách khỏi PV_EMAIL_ENABLED có chủ ý: cờ kia quyết định có mail nào rời máy
# hay không, cờ này quyết định đường bulk có được dùng hay không. Dừng chiến
# dịch mà vẫn phải báo lead mới thì cần đúng cặp này.
PV_MAS_ENABLED=false

# `From`/`Reply-To` của một lô MAS — đọc MỘT LẦN lúc tạo lô rồi chép vào
# `mail_run`; composer gửi theo bản chép đó, không đọc lại biến này. Để riêng
# với PV_EMAIL_FROM vì reputation của mail marketing không được dính vào
# subdomain đang chuyển mail giao dịch.
PV_EMAIL_MAS_FROM=Pebble Vina <hello@mas.pebblevina.com>
PV_EMAIL_MAS_REPLY_TO=contact@pebblevina.com

# Trần người nhận của MỘT lô. Soi gương `MAS_MAX_RECIPIENTS` (200) trong
# @pv/contracts mà màn cũng đọc; ở đây là phanh của người vận hành. Trần cứng
# 1000 — quá đó thì đúng công cụ là chiến dịch có định nghĩa tệp, không phải
# một danh sách chọn tay không ai duyệt kịp.
PV_MAS_BATCH_MAX=200

# Khoá HMAC ký MỌI liên kết huỷ đăng ký (`platform/mail/unsubscribe-token.ts`).
# Thiếu nó thì liên kết chỉ còn là một delivery id trần — ai đếm được là huỷ
# đăng ký được của người khác. Sinh bằng `openssl rand -hex 32`, đặt bằng
# `fly secrets set`, KHÔNG commit. Đổi khoá là vô hiệu hoá mọi liên kết trong
# mọi thư đã gửi, nên chỉ đổi khi có sự cố.
PV_UNSUBSCRIBE_SECRET=

# Gốc công khai của CHÍNH API này — nơi liên kết huỷ đăng ký trỏ tới
# (`POST|GET /mail/unsubscribe/:token`, `platform/mail/unsubscribe.controller.ts`).
# KHÔNG phải PV_APP_URL: huỷ đăng ký một-chạm (RFC 8058) là POST do chính máy
# chủ Gmail/Yahoo gửi, không phiên, không trình duyệt, nên nó phải rơi đúng vào
# cửa API. Trỏ nhầm sang web thì mọi lượt huỷ chết lặng — người nhận tưởng đã
# huỷ rồi báo spam lá thư sau, tức tệ hơn là không có liên kết.
# Bỏ trống thì lùi về PV_APP_URL, chỉ đúng khi API nằm sau cùng một origin;
# `PV_MAS_ENABLED=true` từ chối khởi động nếu biến này rỗng.
PV_API_PUBLIC_URL=http://localhost:3000

# Nhịp hỏi hàng đợi. Mỗi lần hỏi là một truy vấn, và Neon chỉ ngủ khi không ai
# hỏi — nên con số này là một khoản tiền, không chỉ là độ trễ.
PV_QUEUE_POLL_SECONDS=12

# Worker nên đi đường KHÔNG qua pooler (Neon "direct connection"). Bỏ trống
# thì dùng chung DATABASE_URL.
PV_QUEUE_DATABASE_URL=
