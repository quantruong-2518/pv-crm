# Chép thành `.env` rồi sửa. `.env` bị .gitignore chặn — không commit.

# ---------------------------------------------------------------------------
# DATABASE — mặc định KHÔNG cần cài gì
# ---------------------------------------------------------------------------
# `pglite://` chạy CHÍNH Postgres, biên dịch sang WASM, trong tiến trình Node
# này: không container, không daemon, không cổng, không sudo. Cùng engine nên
# recursive CTE, hai schema, `text[]`, `uuid` đều chạy y hệt.
#
#   pglite://./.pglite   dữ liệu nằm trong thư mục đó, còn sau khi tắt
#   pglite://memory      chết theo tiến trình — dùng cho test
#
# Đổi sang Postgres thật (giống production) thì `pnpm db:up` rồi dùng dòng bị
# ghi chú bên dưới. `env.ts` từ chối khởi động nếu thấy `pglite://` ở
# NODE_ENV=production.
DATABASE_URL=pglite://./.pglite
# DATABASE_URL=postgres://pv:pv@localhost:5432/pv_crm

# Neon (production) — copy chuỗi "Pooled connection" từ Neon dashboard.
# `sslmode=require` là bắt buộc, Neon từ chối kết nối không TLS.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# CỬA SAU CỦA GIAI ĐOẠN POC — đọc kỹ trước khi bật
# ---------------------------------------------------------------------------
# App web hôm nay chưa có token thật (`app/auth/session.ts` cố tình không giữ
# token giả), nó chỉ gắn header `X-PV-Actor-Id`. Bật cờ này cho phép máy chủ
# TIN header đó và coi người gọi là actor tương ứng — nghĩa là bất kỳ ai gọi
# được API cũng đóng vai được bất kỳ ai.
#
# Chỉ đúng ở máy phát triển. `env.ts` từ chối khởi động nếu cờ này bật khi
# NODE_ENV=production.
PV_TRUST_ACTOR_HEADER=true

# ---------------------------------------------------------------------------
# LANDING PAGE INTAKE — cửa ghi công khai
# ---------------------------------------------------------------------------
# Danh sách phân cách bằng dấu phẩy. Ở production, cả hai danh sách và secret
# đều bắt buộc; máy chủ từ chối khởi động nếu thiếu để không vô tình mở một cửa
# ghi không có hàng rào.
PV_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PV_INTAKE_LANDING_PAGES=pv-one-demo

# Dev dùng được giá trị mặc định. Production tạo secret riêng, ví dụ:
#   openssl rand -hex 32
PV_INTAKE_IP_HASH_SECRET=development-only-intake-secret

# Một IP: tối đa 5/phút và 30/ngày. Một landing page: tối đa 120/phút và
# 5.000/ngày. Bộ đếm nằm trong Postgres nên nhiều API instance vẫn dùng chung.
PV_INTAKE_RATE_PER_MINUTE=5
PV_INTAKE_RATE_PER_DAY=30
PV_INTAKE_PAGE_RATE_PER_MINUTE=120
PV_INTAKE_PAGE_RATE_PER_DAY=5000
PV_INTAKE_MAX_INFLIGHT=8

# ---------------------------------------------------------------------------
# MAIL — cửa ra ngoài công ty, mặc định ĐÓNG
# ---------------------------------------------------------------------------
# `PV_EMAIL_ENABLED=false` KHÔNG tắt hàng đợi. Job vẫn chạy, sổ gửi vẫn ghi,
# chỉ không có request nào rời khỏi máy này. Xem trước một email thật mà không
# bắn nhầm vào hộp thư người thật — trạng thái đúng của mọi máy phát triển.
PV_EMAIL_ENABLED=false

# Khoá thật: đặt bằng `fly secrets set`, KHÔNG commit.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# `From` phải thuộc domain đã verify trên Resend. Dùng subdomain riêng để
# reputation của mail hệ thống không dính vào hộp thư người thật đang gửi qua
# Google Workspace.
PV_EMAIL_FROM=PV One CRM <leads@notify.pebblevina.com>
PV_EMAIL_REPLY_TO=contact@pebblevina.com
PV_LEAD_NOTIFICATION_TO=contact@pebblevina.com

# Gốc app web — email nội bộ mang một liên kết mở thẳng lead trong CRM.
PV_APP_URL=http://localhost:5173

# Nhịp gửi. Trần tự đặt, thấp hơn trần tài khoản Resend để chừa chỗ.
PV_EMAIL_RATE_PER_SECOND=4
PV_EMAIL_WORKER_CONCURRENCY=2
PV_EMAIL_RETRY_LIMIT=8
PV_EMAIL_RETRY_DELAY_SECONDS=5
PV_EMAIL_RETRY_DELAY_MAX_SECONDS=900

# Nhịp hỏi hàng đợi. Mỗi lần hỏi là một truy vấn, và Neon chỉ ngủ khi không ai
# hỏi — nên con số này là một khoản tiền, không chỉ là độ trễ.
PV_QUEUE_POLL_SECONDS=12

# Worker nên đi đường KHÔNG qua pooler (Neon "direct connection"). Bỏ trống
# thì dùng chung DATABASE_URL.
PV_QUEUE_DATABASE_URL=
