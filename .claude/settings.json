{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check:*)",
      "Bash(pnpm check:fast:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm ctx:*)",
      "Bash(pnpm tokens:check:*)",
      "Bash(pnpm css:check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(node tools/scripts/ctx-audit.mjs:*)"
    ],
    "deny": ["Bash(pnpm db:push:*)", "Bash(pnpm db:seed:*)", "Bash(pnpm db:reset:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/scripts/guard-db.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/scripts/on-edit.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "vercel@claude-plugins-official": true
  }
}
